{
  "Sepay": {
    "ApiKey": "your-sepay-api-key-here",
    "WebhookUrl": "/api/sepay/webhook",
    "AccountNumber": "your-bank-account-number"
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host=localhost;Port=5432;Username=postgres;Password=123456;Database=carenest-sepay-dev;"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/sepay-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
